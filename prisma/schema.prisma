generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Constraints that exist ONLY in migration SQL
// ---------------------------------------------------------------------------
// Prisma's schema language has no partial index (`@@unique` takes no WHERE) and
// no CHECK constraint, so the rules below are hand-written in the migrations
// and are invisible to this file. Two consequences worth knowing before running
// `prisma migrate dev`:
//
//   1. Its drift report may list these as "removed" or "changed" objects, and a
//      generated migration may try to DROP them. That is the tool not being
//      able to see them, not real drift — delete those statements from the
//      generated SQL and keep the constraints.
//   2. `prisma db push` and a database built from this file alone (rather than
//      from the migration history) will NOT have them. Build databases with
//      `prisma migrate deploy`.
//
// Partial unique indexes:
//   driver_application_document_live_type_unique   DriverApplicationDocument (driverApplicationId, type) WHERE supersededAt IS NULL
//                                                  — 20260828101406_add_driver_onboarding
//   driver_vehicle_assignment_live_vehicle_unique  DriverVehicleAssignment (vehicleId) WHERE unassignedAt IS NULL
//   driver_vehicle_assignment_live_driver_unique   DriverVehicleAssignment (driverProfileId) WHERE unassignedAt IS NULL
//                                                  — 20260829121728_add_business_fleet_onboarding
//   SavedCard_clientId_default_idx                 SavedCard (clientId) WHERE isDefault
//                                                  — 20260903060000_saved_card_default_unique
//   vehicle_document_live_approved_unique          VehicleDocument (vehicleId, type) WHERE supersededAt IS NULL AND status = 'APPROVED'
//   vehicle_document_live_submission_unique        VehicleDocument (vehicleId, type) WHERE supersededAt IS NULL AND status <> 'APPROVED'
//                                                  — 20261002130000_vehicle_documents
//   LoadOffer_one_pending_per_driver               LoadOffer (driverProfileId) WHERE status = 'PENDING'
//                                                  — 20261002150000_load_offers
//
// CHECK constraints:
//   vehicle_single_owner_check             Vehicle: exactly one of driverProfileId / companyId
//                                          — 20260803182055_freight_platform_pivot
//   Withdrawal_amountTetri_positive        Withdrawal: amountTetri > 0
//   WalletLedgerEntry_amountTetri_nonzero  WalletLedgerEntry: amountTetri <> 0
//                                          — 20261002210000_driver_wallet
//   PendingUpload_single_scope_check       PendingUpload: exactly one of orderId / vehicleId
//                                          — 20261002220000_pending_uploads
//
// Each model's own doc comment says what its constraint is for. When a
// migration adds another, add it to this list.

model User {
  id                  String    @id
  name                String
  email               String
  emailVerified       Boolean   @default(false)
  // True only for accounts a company admin created with a temp password (see the
  // company driver-registration flow). The app layer redirects to the forced
  // password-change screen while this is true, and clears it once the driver
  // successfully changes their password. Better Auth has no built-in "force
  // password change" primitive, so this is a custom application-layer field.
  mustChangePassword  Boolean   @default(false)
  image               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  role                UserRole  @default(CLIENT)
  // Sign-in number for the native driver app, in E.164 (`+995555123456`), owned
  // by Better Auth's `phoneNumber` plugin (see `src/lib/phone-auth.ts`). Set
  // only by verifying an SMS code, never by a profile edit. Null for every
  // email/password account. Deliberately separate from `DriverProfile.phone`,
  // which is a contact detail in whatever format it was typed and is not
  // unique; nothing is backfilled from it.
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  sessions            Session[]
  accounts            Account[]

  // Account moderation, set by an admin from the back office. `isSuspended`
  // alone gates login/API access; the other two are audit context, not logic.
  //
  // That gate lives in `src/lib/auth.ts`, in two halves: a
  // `databaseHooks.session.create.before` that refuses to mint a session for a
  // suspended account, and a `hooks.after` on `/get-session` that destroys an
  // already-issued one. Every route handler and server component in the app
  // reads its session through `auth.api.getSession`, so both halves apply
  // without any individual route checking this column — and none of them do.
  // `POST /api/admin/users/[userId]/suspend` additionally revokes the target's
  // live sessions so the lockout is immediate rather than eventual.
  //
  // This comment previously claimed the same guarantee while no code provided
  // it (issue #24). If the gate is ever moved or removed, this comment is the
  // thing to fix first.
  isSuspended     Boolean   @default(false)
  suspendedAt     DateTime?
  suspendedReason String?

  // Delivery-domain relations. Named relations are required because `User`
  // participates in the `Order` model twice (as client and as driver).
  driverProfile    DriverProfile?
  clientProfile    ClientProfile?
  logisticsCompany LogisticsCompany?
  orders           Order[]           @relation("ClientOrders")
  deliveries       Order[]           @relation("DriverDeliveries")
  savedCards       SavedCard[]

  // Admin back-office relations. `systemUserProfile` exists only for internal
  // staff (role ADMIN); the other two exist for any user — `auditLogs` records
  // the actions a staff member took, `crmSurveyResponses` the surveys a
  // customer answered.
  systemUserProfile  SystemUserProfile?
  auditLogs          AuditLog[]
  crmSurveyResponses CrmSurveyResponse[]

  // Staff-side back references for the two driver-support features. Both are
  // `SetNull` on the other end, so removing a staff account never erases a
  // review verdict or a resolved support message.
  vehicleDocumentsReviewed VehicleDocument[] @relation("VehicleDocumentReviewer")
  supportMessagesResolved  SupportMessage[]  @relation("SupportMessageResolver")

  /// Devices this account receives push notifications on — see `DeviceToken`.
  deviceTokens DeviceToken[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Push tokens registered under this session. Cascade-deleted with it, which
  /// is how sign-out stops pushes to the device — see `DeviceToken`.
  deviceTokens DeviceToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Distinguishes the kinds of Better Auth users in the app: the shipper placing
/// orders, the driver fulfilling them, the fleet operator that owns vehicles and
/// dispatches orders to its own drivers, and internal staff working the `/admin`
/// back office. `ADMIN` is appended last on purpose — reordering an existing
/// Postgres enum's values is a destructive migration, and existing rows already
/// carry the first three.
/// `input: true` on the `role` additional field lets sign-up set this explicitly;
/// the CLIENT default keeps Better Auth's internal inserts safe when it is omitted.
enum UserRole {
  CLIENT
  DRIVER
  COMPANY
  ADMIN
}

/// Whether a client account represents an individual or a business.
enum ClientAccountType {
  INDIVIDUAL
  BUSINESS
}

/// Gender of an individual client, collected during profile verification.
enum ClientGender {
  MALE
  FEMALE
  OTHER
}

/// Individual Entrepreneur (ინდ. მეწარმე) is a distinct Georgian business registration status, separate from both a private individual and a full company.
enum DriverAccountType {
  INDIVIDUAL
  INDIVIDUAL_ENTREPRENEUR
  BUSINESS
}

/// Licence classes a driver may hold, gating which vehicle class they may
/// register during onboarding. B = cars/vans up to 3.5t, C = rigid trucks
/// over 3.5t, CE = truck with trailer / articulated.
enum LicenceCategory {
  B
  C
  CE
}

/// Lifecycle of one driver's onboarding application. `DRAFT` covers the whole
/// in-progress wizard (nothing has been reviewed yet); `PENDING` and
/// `ACTION_REQUIRED` can alternate any number of times as documents are
/// flagged and replaced; `APPROVED` is terminal for this feature (see
/// `requirements.md`'s Assumptions — there is no "rejected, start over" state).
enum DriverApplicationStatus {
  DRAFT
  PENDING
  ACTION_REQUIRED
  APPROVED
}

/// Which of the three documents an onboarding application collects.
enum DriverApplicationDocumentType {
  PROFILE_PHOTO
  LICENCE_FRONT
  LICENCE_BACK
}

/// Per-document review verdict.
enum DriverApplicationDocumentStatus {
  PENDING
  APPROVED
  FLAGGED
}

/// Lifecycle of one company's fleet onboarding application, deliberately
/// identical in shape to `DriverApplicationStatus`: `DRAFT` covers the whole
/// in-progress wizard, `PENDING` and `ACTION_REQUIRED` alternate as items are
/// flagged and corrected, and `APPROVED` is terminal (there is no "rejected,
/// reapply from scratch" state — see requirements.md's Assumptions). A company
/// has exactly one application for its lifetime; a flagged one is corrected and
/// resubmitted in place, never recreated.
enum BusinessApplicationStatus {
  DRAFT
  PENDING
  ACTION_REQUIRED
  APPROVED
}

/// The company-level verdict inside a business application, tracked separately
/// from the application's own `status` because the design reviews the company
/// once and each vehicle individually: the company can be VERIFIED while three
/// vehicles are still PENDING, and one vehicle can be FLAGGED without unpicking
/// the company's verdict. `FLAGGED` carries a reason in
/// `BusinessApplication.companyFlagReason`.
enum CompanyReviewStatus {
  PENDING
  VERIFIED
  FLAGGED
}

/// Per-vehicle review verdict within a business application. Mirrors
/// `DriverApplicationDocumentStatus` — same three values, same meaning: an
/// approved vehicle keeps its verdict across a resubmission, a flagged one is
/// the only kind the company can edit and resend.
enum BusinessApplicationVehicleStatus {
  PENDING
  APPROVED
  FLAGGED
}

/// The order lifecycle, declared in lifecycle order.
///
/// ```text
/// INITIATED ──(payment settles)──► PENDING
///                                     │
///           ┌─────────────────────────┤
///     (company claims)      (independent driver accepts)
///           ▼                         │
///        CLAIMED ──(dispatch)──► ACCEPTED ◄──┘
///                                     │
///                                     ▼
///                                IN_TRANSIT ──► COMPLETED
///
/// any pre-completion state ────────────────────► CANCELLED
/// ```
///
/// `INITIATED` is the pre-payment state: the order exists, but it has not been
/// paid for and is therefore **not on the open market**. Drivers and logistics
/// companies must never see an `INITIATED` order. That property is enforced by
/// construction rather than by a filter: every open-market query keys on
/// `status: PENDING` by *equality* (see `api/logistics-company/orders`,
/// `api/orders/[id]/accept`, `api/orders/[id]/claim`), so a new pre-market value
/// is invisible to them without any query changing. Anything added here that
/// drivers must not see has to keep that shape — a `not`/`notIn` filter on an
/// open-market query would leak it.
///
/// `PENDING` is the open market: paid for, unassigned, visible to every eligible
/// driver and company. Payment settles immediately today, since Pay later is the
/// only method, so the `INITIATED → PENDING` hop is currently instantaneous.
///
/// `CLAIMED` is the company-only intermediate state: a `LogisticsCompany` has
/// taken the order but has not yet dispatched it to one of its own drivers.
/// Independent drivers skip it and go straight from `PENDING` to `ACCEPTED`.
///
/// `IN_TRANSIT` keeps its name for migration cost, and displays as "In transit".
enum OrderStatus {
  INITIATED
  PENDING
  CLAIMED
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

/// The tier a client picks at booking: `PRIORITY` pays a premium for the front of
/// the queue, `REGULAR` is the default, `POOLING` accepts a shared, slower run for
/// a discount. Its effect on the fare is itemised on `Order.serviceLevelAdjustment`.
///
/// Recorded, not yet acted on: dispatch does not read this value in its current
/// form, so no client-facing copy may promise a faster pickup.
enum ServiceLevel {
  PRIORITY
  REGULAR
  POOLING
}

/// Broad duty class of a supported vehicle type.
enum VehicleCategory {
  MEDIUM_DUTY
  HEAVY_DUTY
}

/// The physical body — the load space — of a vehicle. Collected during
/// onboarding on `Vehicle.chassisType`, declared per catalogue entry on
/// `VehicleTypeSpec.bodyTypes`, and recorded on `Order.bodyType` as the body
/// the client asked for.
///
/// It takes no part in *pricing*: the catalogue already discriminates by body
/// (Refrigerated Van is its own `VehicleTypeSpec` with its own `PricingRule`,
/// priced above Closed Box Van), so there is deliberately no body surcharge on
/// top. It does now take part in the client's vehicle *filter* — the booking
/// form narrows the vehicle grid to types whose `bodyTypes` contain the chosen
/// value. Dispatch still matches on `Vehicle.vehicleTypeSpecId` alone and never
/// reads `Vehicle.chassisType`, which is nullable for every vehicle onboarded
/// before it existed. See the `driver-vehicle-onboarding` spec's vehicle-classes
/// mapping for how (class, chassis type) resolves to a specific
/// `VehicleTypeSpec`.
enum ChassisType {
  DRY_BOX
  REFRIGERATED
  OPEN_CHASSIS
}

/// The five vehicle classes both onboarding wizards offer. A presentation-level
/// grouping over the `VehicleTypeSpec` catalogue — pricing and order matching
/// continue to key on `Vehicle.vehicleTypeSpecId` alone and never read this — but
/// stored, not derived, because it is what the company *declared* and what was
/// reviewed and approved. See `src/lib/driver-onboarding/vehicle-classes.ts` for
/// the (class, chassis type) -> spec code map; the licence category each class
/// requires lives there too, not here.
enum VehicleClass {
  SMALL_VAN
  LARGE_VAN
  MEDIUM_TRUCK
  HEAVY_FREIGHT_TRUCK
  TRAILER_TRUCK
}

/// How cargo physically gets in and out of the vehicle — the main practical
/// constraint when matching bulky freight to a vehicle.
enum LoadingAccessType {
  REAR_DOOR
  SIDE_DOOR
  RAMP
  TAIL_LIFT
  OPEN_FLATBED
}

/// What is being shipped. Scoped to commercial freight, not small parcels.
enum CargoCategory {
  FURNITURE_FURNISHINGS
  APPLIANCES
  RETAIL_STOCK
  EVENT_EQUIPMENT
  FULL_RELOCATION
  INDUSTRIAL_SUPPLIES
  CONSTRUCTION_MATERIALS
}

/// Handling requirements a client can attach to a load. Surfaced to drivers on
/// the load board as pills, and the first three are also filter chips.
///
/// `COLD_CHAIN` overlaps with `ChassisType.REFRIGERATED` but is not the same
/// thing: the chassis type is a property of the *vehicle body*, this is a
/// requirement of the *cargo*. A client can declare cold-chain cargo without
/// having picked a refrigerated body, and the mismatch is worth surfacing.
///
/// `HAZMAT` is an ADR licensing matter. Nothing in this schema gates it —
/// `DriverLicence` has no certification field — so it is a warning, not a
/// control. See `specs/driver-load-board/action-required.md`.
enum CargoHandlingTag {
  FRAGILE
  COLD_CHAIN
  HAZMAT
  TIME_CRITICAL
  UPRIGHT_ONLY
  HEAVY_ITEM
}

