generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          UserRole  @default(CLIENT)
  sessions      Session[]
  accounts      Account[]

  // Delivery-domain relations. Named relations are required because `User`
  // participates in the `Order` model twice (as client and as driver).
  driverProfile DriverProfile?
  clientProfile ClientProfile?
  orders        Order[]        @relation("ClientOrders")
  deliveries    Order[]        @relation("DriverDeliveries")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Distinguishes the two kinds of Better Auth users in the app.
/// `input: true` on the `role` additional field lets sign-up set this explicitly;
/// the CLIENT default keeps Better Auth's internal inserts safe when it is omitted.
enum UserRole {
  CLIENT
  DRIVER
}

/// Whether a client account represents an individual or a business.
enum ClientAccountType {
  INDIVIDUAL
  BUSINESS
}

/// Gender of an individual client, collected during profile verification.
enum ClientGender {
  MALE
  FEMALE
  OTHER
}

/// Individual Entrepreneur (ინდ. მეწარმე) is a distinct Georgian business registration status, separate from both a private individual and a full company.
enum DriverAccountType {
  INDIVIDUAL
  INDIVIDUAL_ENTREPRENEUR
  BUSINESS
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum VehicleType {
  // Light Truck (<3.5 tonne)
  FLATBED
  PICKUP
  VENDING_TRUCK
  REFRIGERATED_TRUCK
  ICE_CREAM_TRUCK
  CURTAINSIDER_TRUCK
  BOX_TRUCK
  CHASSIS_TRUCK
  DUMP_TRUCK
  // Cargo Van
  CARGO_DERIVED_VAN
  CLOSED_BOX_VAN
  COMBO_VAN
  ISOTHERMAL_VAN
  REFRIGERATED_VAN
}

/// Cities a driver profile can be based in.
enum GeorgianCity {
  TBILISI
  BATUMI
  KUTAISI
  RUSTAVI
  ZUGDIDI
  GORI
  POTI
  SAMTREDIA
  KHASHURI
  SENAKI
  ZESTAPONI
  MARNEULI
  TELAVI
  AKHALTSIKHE
  OZURGETI
  KOBULETI
  CHIATURA
  TSKALTUBO
  SAGAREJO
  GARDABANI
  BOLNISI
  AKHALKALAKI
  BORJOMI
  KASPI
  MTSKHETA
}

enum PackageType {
  DOCUMENT
  SMALL_PARCEL
  MEDIUM_PARCEL
  LARGE_PARCEL
}

/// Driver-specific profile data: online status, vehicle, and live location.
model DriverProfile {
  id         String      @id @default(cuid())
  userId     String      @unique
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOnline   Boolean     @default(false)
  city       GeorgianCity
  vehicleType VehicleType?
  accountType DriverAccountType
  firstName   String?
  lastName    String?
  companyName String?
  vatId       String?
  phone       String
  currentLat Float?
  currentLng Float?
  // Set only when `currentLat`/`currentLng` are pushed by the driver's location
  // beacon — distinct from `updatedAt`, which bumps on any profile edit, so the
  // tracking UI can tell a fresh position from a stale one.
  locationUpdatedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  vehicles   Vehicle[]
}

/// A vehicle a driver operates. A driver may register any number of them.
/// `plateNumber` is unique across all vehicles for the same reason
/// `ClientProfile.phone` is unique for clients: a plate identifies one real
/// vehicle, so the constraint is what stops the same vehicle being claimed by
/// two drivers at the DB level.
/// `photoUrls` holds public Supabase Storage URLs; the DB row is the source of
/// truth, and the objects themselves are removed best-effort on delete.
model Vehicle {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  plateNumber     String        @unique
  make            String
  model           String
  year            Int
  vehicleType     VehicleType
  /// Load capacity in kilograms. Optional — not every driver knows or wants to
  /// publish it, and it is display-only for now.
  capacityKg      Float?
  photoUrls       String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orders          Order[]

  @@index([driverProfileId])
}

/// Client-specific profile data. Individual accounts use first/last name;
/// business accounts use company name and VAT id. `phone` is required for both
/// and is unique across all clients: a phone number identifies a real person or
/// business, so it is what enforces "one account per client" at the DB level.
model ClientProfile {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType ClientAccountType
  firstName   String?
  lastName    String?
  companyName String?
  vatId       String?
  phone       String            @unique
  // Verification details, individual accounts only (nullable for business).
  dateOfBirth DateTime?
  gender      ClientGender?
  idNumber    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// A single delivery request placed by a client and optionally taken by a driver.
model Order {
  id          String      @id @default(cuid())
  packageType PackageType @default(SMALL_PARCEL)
  description String?

  pickupAddress String
  pickupLat     Float?
  pickupLng     Float?

  dropoffAddress String
  dropoffLat     Float?
  dropoffLng     Float?

  distanceKm  Float
  price       Float
  vehicleType VehicleType
  status      OrderStatus @default(PENDING)

  clientId String
  client   User   @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade)

  driverId String?
  driver   User?   @relation("DriverDeliveries", fields: [driverId], references: [id], onDelete: SetNull)

  // The specific vehicle the driver picked at accept time. Nulled rather than
  // cascaded on vehicle deletion (same reasoning as `driverId`): retiring a
  // vehicle must not erase the delivery history it took part in.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
}
