  KHULO
  SHUAKHEVI
}

/// A vehicle "make/model class" the platform supports — e.g. "Box Truck". Specs and
/// pricing are data (seeded), not hardcoded UI constants, so they can be tuned without
/// a code change. `code` is the stable identifier other tables and UI option lists key on.
model VehicleTypeSpec {
  id                String            @id @default(cuid())
  code              String            @unique
  label             String
  category          VehicleCategory
  maxPayloadKg      Float
  cargoLengthM      Float
  cargoWidthM       Float
  /// `0` means "open / no height limit" (an open flatbed has no cargo box), not a
  /// literal zero-height constraint.
  cargoHeightM      Float
  loadingAccessType LoadingAccessType
  /// Which load spaces this vehicle type offers. Drives the client-facing body
  /// filter on the booking form, so the taxonomy owns the mapping rather than a
  /// literal table inside a component — a new vehicle type is filterable the
  /// moment it is seeded, with no code change.
  ///
  /// A list, not a single value, because several types genuinely serve more than
  /// one body: a reefer can run its box dry, and a curtainsider opens along both
  /// sides. Empty by default, which reads as "offers no body the filter knows
  /// about" and simply hides the type from every filtered grid until seeded.
  bodyTypes         ChassisType[]
  /// Public Supabase Storage URL of a marketing photo for this vehicle class,
  /// set by a content manager from the back office (never by a driver, and
  /// never by the seed). It lives in the public `site-media` bucket, so the
  /// URL is directly renderable and no signed request is needed.
  ///
  /// Display-only, and deliberately so: order matching and pricing key on
  /// `Vehicle.vehicleTypeSpecId` and `PricingRule` alone and never read this.
  /// Nullable because no photography exists yet — the marketing page falls
  /// back to its inline vehicle glyphs for a type with no photo, so a null
  /// here is a normal, permanent-until-filled state rather than a gap to
  /// backfill.
  ///
  /// Not to be confused with `Vehicle.photoUrls`, which holds the photos a
  /// driver uploads of their own specific vehicle into the separate
  /// `vehicle-photos` bucket. This one is a picture of the *class*.
  imageUrl          String?
  pricingRule       PricingRule?
  vehicles          Vehicle[]
  orders            Order[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

/// One pricing rule per vehicle type. `freeLoadingMinutes` is the buffer before
/// `overtimeRatePerMinute` kicks in; `minimumFare` is a floor applied after all other
/// components are summed. `helperFee` is a per-helper rate, charged once for each
/// helper in an order's `helperCount` — not a one-off fee for the whole booking.
model PricingRule {
  id                    String          @id @default(cuid())
  vehicleTypeSpecId     String          @unique
  vehicleTypeSpec       VehicleTypeSpec @relation(fields: [vehicleTypeSpecId], references: [id], onDelete: Cascade)
  baseFare              Float
  pricePerKm            Float
  pricePerMinute        Float
  freeLoadingMinutes    Int
  overtimeRatePerMinute Float
  helperFee             Float
  minimumFare           Float
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

/// A fleet operator: its own login (role COMPANY), owns vehicles directly, and manages a
/// roster of drivers who fulfil the orders it dispatches to them. Phone is unique for the
/// same reason ClientProfile.phone is: it identifies one real business, one account.
/// The legal/contact/payout block below is collected by the fleet onboarding wizard
/// (`specs/business-fleet-onboarding`); every field in it is nullable because companies
/// created by the back office before that wizard existed have none of it.
model LogisticsCompany {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  vatId       String
  phone       String       @unique
  /// The company's primary / registered city. Retained alongside
  /// `citiesOfOperation` — see the field's own comment.
  city        GeorgianCity

  /// Registered legal address as it appears on the company's registration.
  /// Free text: Georgian addresses are not structured consistently enough to
  /// normalise into street/number/postcode columns, and nothing queries on it.
  registeredAddress String?
  /// Payout account. Order revenue is settled here weekly, so it must belong to
  /// the registered entity — a rule an admin verifies during review, not one the
  /// schema can enforce. Stored as entered, minus spaces (the API normalises).
  bankAccountIban   String?
  /// The named person operations calls when an order needs a decision, their role
  /// in the company, and their email. Three plain columns rather than a
  /// `CompanyContact` model: there is exactly one contact per company in v1 (see
  /// requirements.md's "Multi-user company accounts" non-goal), and a 1:1 table
  /// would buy nothing but a join.
  contactName       String?
  contactRole       String?
  contactEmail      String?

  /// Every city this fleet picks up in. Orders outside these cities are not
  /// offered to the company's drivers. A Postgres enum array rather than a join
  /// table, following `DriverLicence.categories` — the list is short, always read
  /// whole, and never queried from the other side.
  citiesOfOperation GeorgianCity[]

  /// Set when an admin activates the fleet: the company is verified AND at least
  /// one of its vehicles is approved. Null means "cannot dispatch" — enforced
  /// server-side in task-21, not just hidden in the UI. A stored timestamp rather
  /// than a value derived from the application row on every request, mirroring
  /// `DriverProfile.activatedAt` and `User.suspendedAt`.
  activatedAt DateTime?

  drivers     DriverProfile[]
  vehicles    Vehicle[]
  orders      Order[]
  application BusinessApplication?

  /// Loads this company's dispatcher has hidden from the company's board. The
  /// company account rejects, never its roster drivers — see `LoadRejection`.
  loadRejections LoadRejection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One fleet onboarding application per logistics company, 1:1 on
/// `LogisticsCompany`. `draft` holds the in-progress wizard (company details,
/// fleet composition counts, and one entry per vehicle carrying its
/// specification and its assigned driver) as
/// a versioned JSON blob — the exact shape is defined and narrowed in task-05 —
/// so nothing normalized is written until submit succeeds.
/// `reference` is the short human-readable code shown to the company and to the
/// admin reviewer (e.g. "BIZ-40219"); a bare `cuid` is not fit to read aloud in a
/// support call. It is NOT nullable: the row is only ever created by task-05's
/// lazy `GET`, which allocates the reference in the same `create` — never at
/// submit, and never as a nullable column filled in later.
/// `companyReviewStatus` is the company-level verdict and is
/// deliberately separate from `status`: the company is reviewed once, each
/// vehicle individually (see `BusinessApplicationVehicle`).
/// Admin review actions are recorded as `AuditLog` rows rather than a reviewer FK
/// on this model, matching every other admin mutation in this codebase.
model BusinessApplication {
  id        String           @id @default(cuid())
  companyId String           @unique
  company   LogisticsCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  reference String                    @unique
  status    BusinessApplicationStatus @default(DRAFT)

  draft          Json?
  draftStep      Int       @default(1)
  draftUpdatedAt DateTime?

  companyReviewStatus CompanyReviewStatus @default(PENDING)
  /// Set only when `companyReviewStatus` is `FLAGGED`; cleared when the company
  /// resubmits. Exactly one of the four company-level flag reasons from the
  /// design — a CLOSED list, validated against those exact strings server-side.
  /// Free text is rejected; if operations needs an "Other" reason it is added to
  /// the list, not typed into this column.
  companyFlagReason   String?

  firstSubmittedAt DateTime?
  lastSubmittedAt  DateTime?
  submissionCount  Int       @default(0)

  vehicles  BusinessApplicationVehicle[]
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([status])
}

/// One reviewed vehicle inside a business fleet application. Rows are created at
/// submit time (task-14), in the same transaction that creates the `Vehicle`
/// rows themselves — never from a draft, since the vehicles do not exist until
/// then. `status` is the per-vehicle verdict the design shows on the status
/// screen and in the admin drawer: an `APPROVED` vehicle keeps its verdict
/// across a resubmission, and only a `FLAGGED` one is editable.
model BusinessApplicationVehicle {
  id                    String              @id @default(cuid())
  businessApplicationId String
  businessApplication   BusinessApplication @relation(fields: [businessApplicationId], references: [id], onDelete: Cascade)
  /// Nullable + SetNull: a company can remove a vehicle from its own fleet at any
  /// time through an existing, unrelated flow, and the review row must survive so
  /// the admin drawer can render "vehicle no longer on file" rather than vanishing
  /// a decided verdict. Mirrors `DriverApplication.vehicleId`.
  vehicleId             String?             @unique
  vehicle               Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  /// Denormalised at submit so the admin queue, the drawer and the dispatch gate
  /// can read the declared class and body without a join that a null `vehicleId`
  /// would break. NOT NULL: unlike `Vehicle.vehicleClass` (which is nullable and
  /// deliberately un-backfilled for rows that predate this feature), every row
  /// here is created by task-14's submit from a draft that has both values.
  vehicleClass VehicleClass
  chassisType  ChassisType

  status     BusinessApplicationVehicleStatus @default(PENDING)
  /// Set only when `status` is `FLAGGED`; cleared when the vehicle is corrected
  /// and resubmitted. Exactly one of the six per-vehicle flag reasons from the
  /// design — a CLOSED list, validated against those exact strings server-side.
  /// Free text is rejected; if operations needs an "Other" reason it is added to
  /// the list, not typed into this column.
  flagReason String?
  /// When an admin last recorded a verdict on this row. Null while `PENDING`,
  /// stamped on approve/flag, and cleared back to null when the company corrects
  /// the vehicle through task-14's per-vehicle `PATCH`.
  decidedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessApplicationId])
}

/// Driver-specific profile data: online status, vehicle, and live location.
model DriverProfile {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  isOnline         Boolean           @default(false)
  city             GeorgianCity
  accountType      DriverAccountType
  firstName        String?
  lastName         String?
  companyName      String?
  vatId            String?
  phone            String
  idNumber         String?
  dateOfBirth      DateTime?
  // Private-bucket object path, mirrored from the approved `PROFILE_PHOTO`
  // `DriverApplicationDocument` at approval time — not written at upload, so a
  // retaken photo can never leave this pointing at a superseded object.
  profilePhotoPath String?

  /// Who to call if something happens to the driver on a job. Both optional and
  /// independent; the phone is stored in E.164 like every other number. Edited
  /// by the driver through `PATCH /api/dashboard/hub/account/profile`.
  emergencyContactName  String?
  emergencyContactPhone String?

  // Set when the driver joins a fleet's roster; null means an independent driver.
  // `SetNull` (not `Cascade`) so removing a driver from a company — or deleting the
  // company outright — leaves the driver's account intact, just independent again.
  companyId String?
  company   LogisticsCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Set once an admin approves this driver's onboarding application (or, for
  // account types/paths that never go through onboarding — BUSINESS sign-ups
  // and company-created drivers — set immediately at creation). Null means
  // "not yet activated": the driver cannot go online, cannot appear in a
  // client's open-orders match, and cannot accept an order — all three
  // enforced server-side, not just the online toggle. A stored timestamp
  // rather than a derived read, mirroring how `User.mustChangePassword` and
  // `suspendedAt` are both stored rather than computed live on every request.
  activatedAt DateTime?

  currentLat        Float?
  currentLng        Float?
  // Set only when `currentLat`/`currentLng` are pushed by the driver's location
  // beacon — distinct from `updatedAt`, which bumps on any profile edit, so the
  // tracking UI can tell a fresh position from a stale one.
  locationUpdatedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vehicles    Vehicle[]
  assignments DriverVehicleAssignment[]
  licence     DriverLicence?
  application DriverApplication?

  /// Loads this driver has hidden from their own board. Never a cancellation —
  /// see `LoadRejection`.
  loadRejections LoadRejection[]

  /// Messages this driver sent to support from the app.
  supportMessages SupportMessage[]

  /// Pushed load offers made to this driver — see `LoadOffer`.
  loadOffers LoadOffer[]

  /// Which push notifications this driver wants, and their quiet hours. Absent
  /// until the driver first changes something — see `DriverNotificationSettings`.
  notificationSettings DriverNotificationSettings?

  /// Saved routes the driver wants to hear about — see `RouteAlert`.
  routeAlerts     RouteAlert[]
  routeAlertFires RouteAlertFire[]

  /// What work the driver wants to be offered. Absent until first saved, and
  /// absent means "offer me anything I am eligible for".
  workPreferences DriverWorkPreferences?

  /// The driver wallet — independent drivers only. See `WalletLedgerEntry`.
  bankAccounts      DriverBankAccount[]
  withdrawals       Withdrawal[]
  walletEntries     WalletLedgerEntry[]
  walletCreditHolds WalletCreditHold[]

  @@index([companyId])
}

/// A driver's licence on file, collected during onboarding and written at
/// submit time (see `DriverApplication.draft`). 1:1 with `DriverProfile` — a
/// driver has exactly one current licence; a future renewal flow would
/// update this row in place, not create a new one. `categories` gates which
/// vehicle classes the driver may register. No document paths here — both
/// licence photos are `DriverApplicationDocument` rows.
model DriverLicence {
  id              String            @id @default(cuid())
  driverProfileId String            @unique
  driverProfile   DriverProfile     @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  licenceNumber   String
  expiresAt       DateTime
  categories      LicenceCategory[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

/// One onboarding application per independent driver, 1:1 on `DriverProfile`.
/// `draft` carries the whole in-progress wizard as a versioned JSON blob so the
/// wizard is resumable before anything is validated or written to normalized
/// tables — `Vehicle` and `DriverLicence` rows are created only at a successful
/// submit, inside one transaction, because `Vehicle.plateNumber` is globally
/// unique and an abandoned draft must never permanently claim a real plate.
/// `reference` is the short human-readable code shown to the driver and the
/// admin reviewer (e.g. "APP-40219") — a bare `cuid` isn't fit for that. Admin
/// review actions (approve/flag a document, request changes, approve the
/// driver) are recorded as `AuditLog` rows rather than a reviewer FK on this
/// model, matching how every other admin action in this codebase is audited.
model DriverApplication {
  id              String                  @id @default(cuid())
  driverProfileId String                  @unique
  driverProfile   DriverProfile           @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  reference       String                  @unique
  status          DriverApplicationStatus @default(DRAFT)
  draft           Json?
  draftStep       Int                     @default(1)
  draftUpdatedAt  DateTime?

  // Set only once submit succeeds and the Vehicle row exists (SetNull, not
  // Cascade, so retiring a vehicle later never erases application history —
  // matches Order.vehicleId's existing onDelete choice).
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  firstSubmittedAt DateTime?
  lastSubmittedAt  DateTime?
  submissionCount  Int                         @default(0)
  documents        DriverApplicationDocument[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([status])
}

/// One row per uploaded onboarding document per review round. A retake
/// inserts a new row and supersedes the previous one rather than overwriting
/// it, so an earlier rejection reason stays visible to the reviewer. Exactly
/// one row per (driverApplicationId, type) has `supersededAt: null` — the
/// live one — enforced by a partial unique index added by hand in the
/// migration SQL, the same pattern `Vehicle.vehicle_single_owner_check`
/// already uses for a constraint Prisma's schema language can't express
/// natively.
model DriverApplicationDocument {
  id                  String                          @id @default(cuid())
  driverApplicationId String
  driverApplication   DriverApplication               @relation(fields: [driverApplicationId], references: [id], onDelete: Cascade)
  type                DriverApplicationDocumentType
  storagePath         String
  status              DriverApplicationDocumentStatus @default(PENDING)
  flagReason          String?
  supersededAt        DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@index([driverApplicationId])
}

/// A vehicle owned either by an independent driver or by a logistics company —
/// exactly one of `driverProfileId`/`companyId` is set, enforced by the
/// `vehicle_single_owner_check` CHECK constraint (Prisma has no native XOR, so it
/// lives in the migration SQL) and by the API layer for a readable error message.
/// `plateNumber` is unique across all vehicles for the same reason
/// `ClientProfile.phone` is unique for clients: a plate identifies one real
/// vehicle, so the constraint is what stops the same vehicle being claimed by
/// two owners at the DB level.
/// Load capacity and cargo dimensions authoritative for pricing and order
/// matching come from `vehicleTypeSpec` — that remains the single source of
/// truth per vehicle class. `payloadKg`/`cargoLengthM`/`cargoWidthM`/
/// `cargoHeightM` below are separate, driver-declared overrides collected
/// during onboarding for compliance display only; nothing outside the
/// onboarding admin review reads them.
/// `photoUrls` holds public Supabase Storage URLs; the DB row is the source of
/// truth, and the objects themselves are removed best-effort on delete.
model Vehicle {
  id                String            @id @default(cuid())
  driverProfileId   String?
  driverProfile     DriverProfile?    @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  companyId         String?
  company           LogisticsCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleTypeSpecId String
  vehicleTypeSpec   VehicleTypeSpec   @relation(fields: [vehicleTypeSpecId], references: [id])
  plateNumber       String            @unique
  make              String
  model             String
  year              Int
  colour            String?
  // Body type as collected during onboarding — display/compliance only, see
  // the ChassisType enum's own doc comment.
  chassisType       ChassisType?
  /// The class the owner declared at onboarding, e.g. a 24 t articulated
  /// Trailer Truck. Nullable: every vehicle registered before this feature
  /// (the back office's "add a vehicle" form, the individual driver wizard's
  /// pre-existing rows) has none, and deriving one for them is exactly the
  /// operation this column exists to avoid. Consumers must treat `null` as
  /// "no declared class" and fall back to `vehicleTypeSpec.label`.
  vehicleClass      VehicleClass?
  // Driver-declared overrides collected during onboarding, distinct from
  // vehicleTypeSpec's class-level values. They began as attestations for
  // compliance review only. That is still true of *pricing*, which continues to
  // read vehicleTypeSpec's payload/dimensions alone — the single source of truth
  // for what a *class* of vehicle can carry — and of dispatch matching, which
  // keys on vehicleTypeSpecId.
  //
  // It is no longer true in general: `capabilityOf` in
  // `src/lib/orders/vehicle-fit.ts` reads these columns to decide whether a
  // specific vehicle can carry a specific load on the driver load board,
  // preferring the declared value and falling back to the spec when it is null.
  // The fit filter is about the truck that actually turns up, so the vehicle's
  // own declared capacity is the more accurate figure there.
  //
  // A submit-time server check requires payloadKg to be at or above the resolved
  // spec's maxPayloadKg, so a vehicle can never be registered under a class it
  // physically can't meet.
  payloadKg         Float?
  cargoLengthM      Float?
  cargoWidthM       Float?
  cargoHeightM      Float?

  photoUrls          String[]
  orders             Order[]
  assignments        DriverVehicleAssignment[]
  driverApplications DriverApplication[]

  /// Singular, not a list, because `BusinessApplicationVehicle.vehicleId` is
  /// `@unique`: a vehicle appears in at most one business application review row
  /// for its lifetime. task-21's dispatch gate is written as
  /// `vehicle.applicationVehicle !== null && vehicle.applicationVehicle.status !== "APPROVED"`,
  /// which does not typecheck against an array.
  applicationVehicle BusinessApplicationVehicle?

  /// Registration and insurance uploads, every round of them — see
  /// `VehicleDocument` for which rows are live.
  documents VehicleDocument[]

  /// Offers that named this vehicle as the one the load fits — see `LoadOffer`.
  loadOffers LoadOffer[]

  /// Upload URLs issued for this vehicle's documents and not yet registered —
  /// see `PendingUpload`.
  pendingUploads PendingUpload[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverProfileId])
  @@index([companyId])
}

/// The compliance documents a vehicle carries after onboarding. Onboarding
/// collects neither, so a vehicle with no row for a type is the ordinary
/// starting state ("missing"), not a fault.
enum VehicleDocumentType {
  REGISTRATION
  INSURANCE
}

/// The back office's verdict on one uploaded vehicle document. The same three
/// values, with the same meaning, as `DriverApplicationDocumentStatus`.
enum VehicleDocumentStatus {
  PENDING
  APPROVED
  FLAGGED
}

/// One uploaded registration or insurance file for a vehicle — one row per
/// upload, never overwritten, so a vehicle's rows are its document history.
///
/// A (vehicle, type) pair has up to two **live** rows (`supersededAt: null`):
///
/// * the document **on file** — the live `APPROVED` row, the one whose
///   `expiresAt` says whether the vehicle is covered; and
/// * the **submission** — the live `PENDING` or `FLAGGED` row, an upload the
///   back office has not accepted (yet).
///
/// They are separate rows on purpose: a renewal must not displace the document
/// on file until a reviewer has accepted it, or a driver who uploads next
/// year's policy a week early would be left with no valid insurance for as long
/// as the review queue is. Approving the submission supersedes the previous
/// on-file row in the same transaction; uploading again supersedes the previous
/// submission. Both "at most one" rules are partial unique indexes added by hand
/// in the migration SQL (`vehicle_document_live_approved_unique`,
/// `vehicle_document_live_submission_unique`) — the pattern
/// `DriverApplicationDocument` uses for its own live row.
///
/// `expiresAt` is written by the reviewer at approval, never by the driver: the
/// app's renew flow captures a photograph and nothing else, and the date that
/// decides whether a vehicle is insured should be one a member of staff read
/// off the document rather than one the interested party typed. Null means "no
/// expiry" (a registration certificate has none) or "not reviewed yet". Stored
/// at UTC midnight of the calendar date, like `DriverLicence.expiresAt`.
///
/// `storagePath` is an object path in the private `driver-documents` bucket —
/// the bucket the onboarding documents already live in, under a `vehicles/`
/// prefix no driver-profile id can collide with.
model VehicleDocument {
  id          String                @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        VehicleDocumentType
  storagePath String                @unique
  status      VehicleDocumentStatus @default(PENDING)
  flagReason  String?
  expiresAt   DateTime?

  // Who reviewed it and when — columns as well as `AuditLog` rows, because the
  // review queue prints both and an audit log is not something a list joins to.
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("VehicleDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  supersededAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([vehicleId, type])
  @@index([status, supersededAt])
}

/// Persistent driver↔vehicle pairing, distinct from `Order.driverId`/
/// `Order.vehicleId` which only pair the two for a single delivery. Created when a
/// company admin assigns a fleet vehicle to a driver (at registration or later).
/// A join table rather than a bare FK on `DriverProfile` so reassignment keeps
/// history: `unassignedAt` is set instead of the row being deleted. At most one
/// row per vehicle — and at most one per driver — has `unassignedAt: null` at a
/// time, enforced by two partial unique indexes added by hand in the migration
/// SQL (`driver_vehicle_assignment_live_vehicle_unique` and
/// `driver_vehicle_assignment_live_driver_unique`), since Prisma's schema
/// language has no partial-index syntax. The API layer still checks both rules
/// first, so callers get a readable error rather than a P2002 — the indexes are
/// what make the rule airtight under concurrency.
model DriverVehicleAssignment {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  assignedAt      DateTime      @default(now())
  unassignedAt    DateTime?

  @@index([driverProfileId])
  @@index([vehicleId])
}

/// Client-specific profile data. Individual accounts use first/last name;
/// business accounts use company name and VAT id. `phone` is required for both
/// and is unique across all clients: a phone number identifies a real person or
/// business, so it is what enforces "one account per client" at the DB level.
model ClientProfile {
  id          String            @id @default(cuid())
  userId      String            @unique
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType ClientAccountType
  firstName   String?
  lastName    String?
  companyName String?
  vatId       String?
  phone       String            @unique
  // Verification details, individual accounts only (nullable for business).
  dateOfBirth DateTime?
  gender      ClientGender?
  idNumber    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// A single freight job placed by a client and fulfilled either by an independent
/// driver or by a logistics company dispatching one of its own drivers.
model Order {
  id String @id @default(cuid())

  /// Human-readable order reference in `GE-48210` form, shown to drivers on the
  /// board and read aloud to support. `Order.id` is a cuid, which nobody can
  /// dictate over a phone. Backfilled for every pre-existing order by this
  /// column's migration, so it is non-null from the start.
  ///
  /// The database default is what makes this column safe to deploy. It is
  /// `NOT NULL`, and `scripts/migrate-deploy.mjs` runs `prisma migrate deploy`
  /// ahead of `next build`, so for the length of a production build the *old*
  /// code — which has never heard of `reference` — is still serving traffic
  /// against the *new* column. Without a default, every order placed in that
  /// window would die on a not-null violation. Drawing from the sequence in the
  /// default means an insert that ignores this column still gets a valid, unique
  /// reference.
  ///
  /// The application nonetheless draws and passes the reference explicitly (see
  /// `src/lib/orders/reference.ts` and `POST /api/orders`): a value the client
  /// supplies is a value it already has, so the create response can carry the
  /// reference without a second round-trip to read back what the default
  /// generated. The default is the safety net, not the mechanism.
  ///
  /// The expression is spelled with its explicit casts because that is how
  /// Postgres stores it once normalised, and `prisma migrate diff` compares
  /// `dbgenerated` strings literally — writing the tidier
  /// `('GE-' || nextval('order_reference_seq'))` here reads better and reports
  /// as permanent schema drift on every run. The migration writes the tidy form;
  /// this is the same expression after the database has had its say.
  reference String @unique @default(dbgenerated("('GE-'::text || nextval('order_reference_seq'::regclass))"))

  cargoCategory CargoCategory
  description   String?

  // The load space the client asked for, used to narrow the vehicle picker at
  // booking time and shown to whoever runs the job. Nullable: every order placed
  // before the filter existed has none, and there is nothing to derive one from.
  // It carries no price of its own — see the `ChassisType` doc comment for why a
  // body surcharge would double-charge the catalogue.
  bodyType ChassisType?

  /// The load's physical description, declared by the client at booking on top
  /// of the vehicle class they picked. All nullable: every order placed before
  /// the load board existed has none, and there is nothing to derive them from.
  ///
  /// These do **not** feed the quote — `src/lib/pricing.ts` prices a vehicle
  /// class, a distance and a helper count, and continues to. They exist so the
  /// board can hide a load that physically will not fit the vehicle a driver
  /// turns up in. A null here means "unknown", and the fit filter treats unknown
  /// as *not fitting* rather than assuming it does: a driver sent to a load that
  /// does not fit has wasted a trip, which is the costlier failure.
  cargoWeightKg Float?
  cargoLengthM  Float?
  cargoWidthM   Float?
  cargoHeightM  Float?

  /// Free text, shown on the board's Cargo column and in the detail drawer.
  /// `packagingDescription` is the form the load takes ("4 pallets"),
  /// `itemQuantity` is what is inside it ("96 cartons"). Two columns rather
  /// than one because the board shows the first under the cargo type and the
  /// second only in the drawer.
  packagingDescription String?
  itemQuantity         String?

  /// Handling requirements. Empty array, never null — an order with no special
  /// requirements has `[]`, which reads the same at every call site. The
  /// `@default([])` is what puts that guarantee in the database rather than only
  /// in Prisma's read behaviour, and it is what keeps this field in step with the
  /// `DEFAULT ARRAY[]::"CargoHandlingTag"[]` its migration writes.
  handlingTags CargoHandlingTag[] @default([])

  // Extra helpers requested *beyond* the driver, 0-3. The booking form asks for
  // a total crew size of 1-4 people, where 1 is the driver working alone, so the
  // number shown to the client is always this one plus one — store the extras,
  // because that is what gets charged: `helperFee` below is this count times the
  // PricingRule's flat per-helper fee for the booked vehicle type.
  helperCount Int @default(0)

  // The client's requested pickup/delivery date and time, collected as the
  // first step of the booking form. Nullable: every order created before this
  // field existed has none, and unlike the fields above it, nothing here
  // feeds the price — it's informational for dispatch, not the quote.
  scheduledAt DateTime?

  /// The window the client will release the load in, and the time it must
  /// arrive by. `scheduledAt` above stays as it is: it is the single instant the
  /// booking form collects today, and these two refine it. All nullable for the
  /// same backfill reason as the cargo columns.
  pickupWindowStart DateTime?
  pickupWindowEnd   DateTime?
  deliveryDeadline  DateTime?

  pickupAddress String
  pickupLat     Float?
  pickupLng     Float?

  dropoffAddress String
  dropoffLat     Float?
  dropoffLng     Float?

  /// The city at each end of the job, resolved server-side at booking from the
  /// structured address components the geocode lookup returns. Nullable, and
  /// deliberately so: an address outside the 63-value `GeorgianCity` enum (a
  /// village, a roadside depot) resolves to null rather than being forced into
  /// the nearest wrong city.
  ///
  /// The load board filters on these. It cannot filter on `pickupAddress` —
  /// that is free text a client typed, and matching "Tbilisi" against it would
  /// hit any address containing the word. Two enum columns are what make the
  /// board's two city dropdowns a real filter rather than a substring search.
  pickupCity  GeorgianCity?
  dropoffCity GeorgianCity?

  // Contact at each end of the job. All optional: the booking form presents them
  // as optional and never blocks on them. Surfaced to the driver and to company
  // ops so whoever turns up knows who to ask for. Six columns rather than a
  // `StopContact` relation because an order carries exactly one pickup and one
  // dropoff address today; if multi-stop arrives, the relation is the right shape
  // and this is reversible.
  pickupContactName     String?
  pickupContactPhone    String?
  /// Block, floor or room at the pickup — free text, because Georgian addresses
  /// vary too much to structure.
  pickupContactDetails  String?
  dropoffContactName    String?
  dropoffContactPhone   String?
  /// Block, floor or room at the dropoff.
  dropoffContactDetails String?

  // Itemised quote, kept alongside the total so a completed order still shows how
  // its price was reached even after the underlying PricingRule is retuned.
  // `price` is the up-front quoted total (base + distance + time + helper, floored
  // at the rule's `minimumFare`); `overtimeFee` is settled on top at completion.
  distanceKm   Float
  baseFare     Float
  distanceFare Float
  timeFare     Float
  helperFee    Float @default(0)
  overtimeFee  Float @default(0)
  price        Float

  // The tier the client chose. `@default(REGULAR)` backfills every order placed
  // before the picker existed to the value it was in fact served at.
  serviceLevel ServiceLevel @default(REGULAR)

  // The tier's effect on the fare, itemised rather than folded into `price` so the
  // breakdown above still reconciles against its own total and the minimum-fare
  // floor keeps meaning what it says. Positive for PRIORITY, negative for POOLING,
  // zero for REGULAR. Always derived server-side from `serviceLevel` — the figure
  // the client's browser displays is never trusted.
  serviceLevelAdjustment Float @default(0)

  /// The platform's cut and the driver's resulting share, both resolved at
  /// creation and stored rather than computed on read. A global rate lives in
  /// `src/lib/orders/payout.ts`, but retuning it must not silently rewrite what
  /// a job completed last month paid — so the rate that applied is kept with the
  /// order. `driverPayout` is
  /// `(price + serviceLevelAdjustment) * (1 - commissionRate)`, rounded to whole
  /// tetri.
  ///
  /// Written precisely, and the precision matters — the basis is rounded
  /// **before** it is commissioned:
  ///
  /// ```ts
  /// driverPayoutFor(roundCurrency(price + serviceLevelAdjustment), commissionRate)
  /// ```
  ///
  /// Both helpers live in `src/lib/orders/payout.ts`; write it that way rather
  /// than rounding once at the end. Adding two `Float` columns leaves binary
  /// dust on the sum, and commissioning the dusty figure lands a tetri away from
  /// commissioning the clean one on a real share of orders — 210 of 20,000
  /// PRIORITY amounts, when the two orderings were measured against each other.
  ///
  /// **The basis is `price + serviceLevelAdjustment`, not `price` alone.** The
  /// adjustment is stored beside `price` rather than folded into it (see its own
  /// comment above), and `POST /api/orders/[id]/pay` charges the client the sum
  /// of the two. Commissioning `price` by itself would hand the platform the
  /// entire Priority uplift: on a 100 GEL fare at PRIORITY the client pays 125,
  /// and a price-only payout leaves the driver 85 against a 40 platform take —
  /// 32%, not 15%.
  ///
  /// `driverPayout` is the ONLY money figure a driver may be shown. `price`,
  /// `serviceLevelAdjustment` and the fare components are the client's total and
  /// must never reach a driver-facing surface.
  ///
  /// The commission is taken from everything the client pays. `helperFee` is
  /// already a component of `price`, so it is commissioned by construction and
  /// needs nothing further. `overtimeFee` is not — it is settled separately at
  /// completion — so it carries its own payout column below.
  commissionRate Float @default(0.15)
  driverPayout   Float @default(0)

  /// The driver's share of `overtimeFee`, resolved when the order completes and
  /// the overtime is known. Kept in its own column rather than folded into
  /// `driverPayout` so that `driverPayout` keeps ONE stable meaning: what the
  /// job was quoted to pay, which is the figure the load board shows a driver
  /// while they decide whether to take it. A figure that silently grew after
  /// completion would make the board's number and the earnings screen's number
  /// disagree for the same job.
  ///
  /// Total driver earnings for an order are `driverPayout + overtimeDriverPayout`.
  /// Commissioned at the same `commissionRate` stored above, so a rate change
  /// between booking and completion cannot apply two different rates to one job.
  overtimeDriverPayout Float @default(0)

  vehicleTypeSpecId String
  vehicleTypeSpec   VehicleTypeSpec @relation(fields: [vehicleTypeSpecId], references: [id])

  // `INITIATED`, because an order should not be born on the open market: it is
  // unpaid at the instant of insert, and `PENDING` means paid and biddable by
  // every eligible driver and company. A default of `PENDING` would put any row
  // written without a status straight in front of drivers, which is the failure
  // direction that costs somebody a wasted trip; `INITIATED` fails the other way
  // — invisible until something deliberately settles it.
  //
  // The live behaviour no longer rests on this default: `POST /api/orders`, the
  // only path that creates orders, names `INITIATED` itself and then calls
  // `settleOrderPayment` (`src/lib/orders/payment-settlement.ts`) to move the
  // order to `PENDING`. So this is a safety net for whatever writes orders next,
  // not the mechanism any current code depends on.
  status OrderStatus @default(INITIATED)

  clientId String
  client   User   @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade)

  // Set when a company claims the order; the assigned driver/vehicle follow at
  // dispatch time. Nulled rather than cascaded for the same reason as `driverId`.
  companyId String?
  company   LogisticsCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  driverId String?
  driver   User?   @relation("DriverDeliveries", fields: [driverId], references: [id], onDelete: SetNull)

  /// **Whose job this was when the driver took it** — written once, by the same
  /// statement that claims the order (`claimOrderForDriver`), and never moved.
  ///
  /// The wallet needs this as a fact about the past. A driver's roster
  /// membership (`DriverProfile.companyId`) is a fact about *now*, and the
  /// credit can be decided weeks after the claim — when a gateway confirms the
  /// payment. Reading the roster then let a driver who claimed a load while
  /// employed, and was removed from the company before the confirmation, be
  /// credited personally for a job that should have been held
  /// (`WalletCreditHoldReason.ROSTER_SELF_CLAIM`).
  ///
  /// Recorded at the **claim**, not at completion: the claim is the moment the
  /// driver commits themselves (and, for a roster driver, the company's
  /// vehicle) to the job, and stamping it there closes the "removed between
  /// claim and completion" window as well as the one after it.
  ///
  /// Null on every order claimed before this column existed, on orders nobody
  /// has claimed, and on a company's own job (`companyId` set — dispatched, not
  /// self-claimed). For a null the wallet falls back to the driver's roster
  /// membership at credit time, which is what it read before.
  driverClaimedAs      DriverClaimCapacity?
  /// The company whose roster the driver was on at the claim; null unless
  /// `driverClaimedAs` is `ROSTER`. A plain column, like
  /// `WalletCreditHold.companyId`: it is a record, and must survive the company.
  driverClaimCompanyId String?

  // The specific vehicle picked at accept/dispatch time. Nulled rather than
  // cascaded on vehicle deletion (same reasoning as `driverId`): retiring a
  // vehicle must not erase the delivery history it took part in.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // Created only once a payment attempt exists for this order; a cash-on-
  // delivery order settled off-platform may never have one.
  payment Payment?

  /// Drivers and companies who have hidden this load from their own board.
  rejections LoadRejection[]

  // How the client said they would settle, and which saved card they picked if
  // they chose one. Both nullable: orders placed before the payment step existed
  // have neither, and CASH and BANK_TRANSFER never name a card. No gateway is
  // integrated, so this records an intention rather than an authorisation — the
  // "pay later" option the client sees is `CASH` under a different label, not a
  // fourth `PaymentMethodType` value.
  paymentMethodType PaymentMethodType?
  savedCardId       String?
  // Nulled rather than cascaded: removing a card must not erase the orders it
  // was chosen for.
  savedCard         SavedCard?         @relation(fields: [savedCardId], references: [id], onDelete: SetNull)

  // Business clients only. A free-text purchase-order number or cost-centre code
  // the client's own finance team needs on the record. Individual clients never
  // see the field, so an individual's order always has null here.
  purchaseOrderRef String?

  inTransitAt    DateTime?
  completedAt    DateTime?
  // Total loading/unloading minutes reported at completion; only the part beyond
  // the rule's `freeLoadingMinutes` is charged as `overtimeFee`.
  waitingMinutes Int?

  /// Who the driver handed the load to, captured as free text in the job
  /// sheet's delivery-confirmation dialog alongside `waitingMinutes`.
  ///
  /// Nullable and staying nullable. It is optional in the dialog, so a delivery
  /// confirmed without a name is not a broken row, and every order completed
  /// before this column existed has none — there is nothing to derive one from,
  /// and inventing "Recipient" for those rows would be worse than an em dash.
  ///
  /// **This is a record, not evidence — the evidence is beside it.** The name
  /// is whatever the driver typed. Proof of delivery is the `podPhotos` rows and
  /// `podSignaturePath` below, which the driver app must register before
  /// `POST /api/orders/[id]/complete` will close the job. Do not build a
  /// proof-of-delivery claim on this column alone.
  ///
  /// Free text rather than a relation to `User`: the person who signs for a
  /// load at a warehouse door is usually not the account that booked it, and
  /// very often has no account at all.
  receivedBy String?

  /// Proof of delivery, part one: one to three photos of the delivered load,
  /// taken by the assigned driver while the order is `IN_TRANSIT`. See
  /// `PodPhoto`.
  podPhotos PodPhoto[]

  /// Pushed offers of this load to individual drivers — see `LoadOffer`.
  loadOffers LoadOffer[]

  /// Upload URLs issued for this order's proof of delivery and not yet
  /// registered — see `PendingUpload`.
  pendingUploads PendingUpload[]

  /// Support messages a driver attached this order to.
  supportMessages SupportMessage[]

  /// Route alerts that fired for this load — see `RouteAlertFire`.
  routeAlertFires RouteAlertFire[]

  /// Wallet postings for this job — at most one `JOB_PAYOUT` and one
  /// `JOB_OVERTIME` — and the hold written when it was deliberately skipped.
  walletEntries    WalletLedgerEntry[]
  walletCreditHold WalletCreditHold?

  /// Proof of delivery, part two: the recipient's signature, as the object path
  /// of a PNG in the **private** `delivery-proofs` Storage bucket — a path, not
  /// a URL, for the reason `DriverApplicationDocument.storagePath` is one: the
  /// bucket is private, so a short-lived signed URL is minted wherever the
  /// image is shown and nothing permanent is ever stored or handed out.
  ///
  /// Null on every order completed before proof of delivery existed, on every
  /// order not yet delivered, and on a delivery closed from the web hub, which
  /// has no capture screen (see `POD_WAIVER_HEADER` in `src/lib/orders/pod-rules.ts`).
  /// One column rather than a row because there is exactly one signature per
  /// delivery; re-signing before completion replaces it.
  podSignaturePath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([driverId])
  @@index([companyId])
  @@index([vehicleId])
  // Indexed because of `onDelete: SetNull`: without it Postgres sequentially
  // scans every order to find referencing rows on each card deletion, which
  // DELETE /api/saved-cards/[id] performs on demand.
  @@index([savedCardId])
  @@index([status])
  // The load board's hot query: open work nobody has claimed yet. `status`
  // alone already has an index above, but the board always pairs it with both
  // assignment columns, and a composite spares a heap lookup per candidate row
  // on what is the most frequently run query in the driver hub.
  @@index([status, driverId, companyId])
  // The board's two city dropdowns filter on these directly — see the columns'
  // own comment for why they exist rather than a `pickupAddress` substring match.
  @@index([pickupCity])
  @@index([dropoffCity])
}

/// In what capacity a driver claimed an open load — see `Order.driverClaimedAs`.
enum DriverClaimCapacity {
  /// On no company's roster at the claim: the job is the driver's own.
  INDEPENDENT
  /// On a company's roster at the claim, claiming for themselves.
  ROSTER
}

/// A signed upload URL the server has issued and whose object has **not** been
/// registered yet — the record that bounds how many such URLs can be
/// outstanding for one order's proof of delivery or one vehicle's documents.
///
/// A signed upload URL is a bearer token for writing one object: Storage lets
/// its holder PUT anything up to the bucket's own limits, and the type and size
/// are only checked when the app *registers* the upload. Without this table an
/// account could mint URLs without limit and fill the bucket with objects no
/// row will ever reference. With it:
///
/// * issuing a URL inserts a row, under the order's / vehicle's row lock, and
///   is refused once `MAX_PENDING_*_UPLOADS` live rows exist
///   (`src/lib/uploads/rules.ts`);
/// * registering the upload — or refusing and discarding it — deletes the row;
/// * a row past `expiresAt` (the lifetime of the signed URL, after which it can
///   no longer be written to) is swept on the next issue for the same order or
///   vehicle, and **its object is removed from Storage** — which is what
///   reclaims an upload that was made and then abandoned.
///
/// In the database rather than in memory because the deployment is serverless:
/// a counter held by one instance bounds nothing.
///
/// Exactly one of `orderId` / `vehicleId` is set, which also names the bucket
/// (`delivery-proofs` / `driver-documents`). Prisma has no XOR, so that is the
/// `PendingUpload_single_scope_check` CHECK constraint in the migration SQL.
/// Both are `Cascade`: the rows are bookkeeping for their parent, and
/// `DELETE /api/driver-profile/vehicles/[id]` reads the paths before it deletes
/// so the objects go too.
model PendingUpload {
  id String @id @default(cuid())

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// The object path the URL was issued for. Unique: a path is minted once.
  storagePath String @unique

  /// When the signed URL stops being usable; the row is swept after this.
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([vehicleId])
}

/// One proof-of-delivery photo. A delivery carries one to three, registered by
/// the assigned driver between `IN_TRANSIT` and `COMPLETED`; completing from the
/// driver app is refused without at least one (and a signature — see
/// `Order.podSignaturePath`).
///
/// `storagePath` is an object path in the **private** `delivery-proofs` bucket,
/// never a URL; readers are handed a short-lived signed URL. Unique, so one
/// uploaded object can never back two rows — deleting a photo may then always
/// delete its object.
///
/// `takenAt` is when the driver's device says the picture was taken — kept only
/// when that lies between the job being started and the server's "now" (clock
/// skew allowed); otherwise, and when the app sends none, it is the server
/// clock (`resolveTakenAt` in `src/lib/orders/pod-rules.ts`). `createdAt` is
/// when the server recorded it. Both are kept because they answer different
/// questions in a dispute, and only the second is beyond the driver's control.
///
/// Rows are frozen once the order is `COMPLETED`: every write path checks the
/// status under a row lock, so the proof a client is shown cannot be edited
/// after the fact.
model PodPhoto {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storagePath String   @unique
  takenAt     DateTime
  createdAt   DateTime @default(now())

  @@index([orderId])
}

/// One driver's (or one company's) decision to hide an open load from their own
/// board. Deliberately *not* a cancellation: the client's booking is untouched
/// and every other driver still sees it.
///
/// Exactly one of `driverProfileId` / `companyId` is set, matching whichever
/// kind of account did the rejecting. Two partial-looking unique constraints
/// rather than one: Postgres treats NULLs as distinct in a unique index, so
/// `@@unique([orderId, driverProfileId])` constrains driver rows and simply does
/// not apply to company rows (whose `driverProfileId` is NULL), and vice versa.
/// The pair therefore gives exactly one rejection per order per account without
/// needing a partial index Prisma cannot express.
///
/// Rows are kept after the load is claimed by someone else rather than cleaned
/// up: this is the raw signal an acceptance-rate model would be built from, and
/// it cannot be backfilled. Nothing reads it that way yet.
model LoadRejection {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  driverProfileId String?
  driverProfile   DriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  companyId String?
  company   LogisticsCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([orderId, driverProfileId])
  @@unique([orderId, companyId])
  @@index([driverProfileId])
  @@index([companyId])
}

/// Where a pushed load offer stands. Only `PENDING` is ever "live", and only
/// while `now < expiresAt` and the order is still open: the row is not flipped
/// by a timer (there is none on this stack), so `PENDING` past its deadline
/// means "expired, not yet swept". `deriveOfferState` in
/// `src/lib/offers/rules.ts` is the one reading of these values.
enum LoadOfferStatus {
  PENDING
  /// The driver accepted and won the claim; the order is theirs.
  ACCEPTED
  DECLINED
  /// The offer's lifetime ran out with no answer.
  EXPIRED
  /// The load stopped being open while the offer was live — somebody else
  /// claimed it.
  WITHDRAWN
}

/// A time-boxed invitation for ONE driver to take ONE open load, pushed to the
/// driver app while they are online. Non-exclusive: the load stays on the public
/// board and may be offered to other drivers at the same time; accepting goes
/// through the same atomic claim as `POST /api/orders/[id]/accept`.
///
/// `@@unique([orderId, driverProfileId])` is what makes "a driver who declined
/// or ignored a load is never offered it again" true by construction: the row
/// is kept, so a second offer cannot be inserted.
///
/// **A second constraint lives in the migration only**, because Prisma cannot
/// express a partial index: `LoadOffer_one_pending_per_driver`, unique on
/// `driverProfileId WHERE status = 'PENDING'`. A driver therefore has at most
/// one unanswered offer, even when two loads open in the same instant; the
/// dispatcher sweeps expired rows to `EXPIRED` before inserting.
model LoadOffer {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  /// The driver's vehicle the matcher found this load fits — what the offer
  /// screen's fit confirmation names and the app sends back on accept. Advisory:
  /// accept re-checks whichever vehicle it is given.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  status LoadOfferStatus @default(PENDING)

  /// Set once at creation (`createdAt` + the offer lifetime) and never moved.
  expiresAt DateTime

  /// When the driver accepted or declined; null for an expired or withdrawn
  /// offer, which nobody answered.
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, driverProfileId])
  @@index([driverProfileId, status])
  @@index([orderId, status, expiresAt])
  @@index([status, expiresAt])
  // Indexed because of `onDelete: SetNull`: without it Postgres sequentially
  // scans every offer to find the referencing rows each time a vehicle is
  // deleted (`DELETE /api/driver-profile/vehicles/[id]`).
  @@index([vehicleId])
}

enum DevicePlatform {
  IOS
  ANDROID
}

/// One device's push token. Unique per token: a token re-registered by another
/// account (a shared phone) moves to that account rather than duplicating.
///
/// Tied to the session that registered it and cascade-deleted with it, so
/// signing out — which deletes the session row — stops pushes to that device
/// without relying on the app to call the unregister endpoint first.
model DeviceToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  platform DevicePlatform
  token    String         @unique

  /// The language the app was showing when it registered — what a push to this
  /// device is written in.
  locale ContentLocale

  /// Refreshed on every registration; the app registers on each launch.
  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}

/// What a support message is about. The first five are the Support screen's
/// radio list, in the design's order; the last five were appended (enum values
/// can only be added, and are added at the end) for the Orders screen's "Report
/// a problem" flow, whose seven types are these five plus
/// `CARGO_DAMAGED_OR_MISSING` and `OTHER`. `src/lib/support/rules.ts` holds
/// both lists in their design order.
enum SupportTopic {
  PICKUP_OR_DROPOFF
  CARGO_DAMAGED_OR_MISSING
  PAYMENT_OR_WITHDRAWAL
  DOCUMENTS_AND_ACCOUNT
  OTHER
  CONTACT_UNREACHABLE
  ADDRESS_WRONG_OR_INACCESSIBLE
  CARGO_MISMATCH
  VEHICLE_BREAKDOWN
  ACCIDENT
}

/// Whether staff still have to deal with a support message.
enum SupportMessageStatus {
  OPEN
  RESOLVED
}

/// One message a driver sent to support from the app: a topic, what happened,
/// and optionally the job it is about.
///
/// A message, not a conversation — there is no reply column because there is no
/// reply channel (no SMS, no push, no in-app thread). Staff read it, contact the
/// driver by phone, and mark it resolved; `resolvedAt`/`resolvedById` record
/// that, and the `AuditLog` records it again as an admin action.
///
/// `orderId` is `SetNull`: a message outlives the order it mentions.
model SupportMessage {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  topic           SupportTopic
  body            String
  orderId         String?
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  status       SupportMessageStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?                @relation("SupportMessageResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverProfileId, createdAt])
  @@index([status, createdAt])
  @@index([orderId])
}

/// A driver's push-notification choices: the Account → Notifications screen.
///
/// **No row means the defaults** (the column defaults below, which are the
/// design's initial state); the row is created by the first `PATCH`. One
/// definition of those defaults for code lives in
/// `DEFAULT_NOTIFICATION_SETTINGS` in `src/lib/notifications/rules.ts`, and a
/// spec pins the two against each other.
///
/// Two things the design shows are deliberately not columns:
///
/// - **Document expiry** is "Always on" in the design — a switch the driver
///   cannot move — so there is nothing to store.
/// - **The quiet-hours time zone** is `Asia/Tbilisi` for every driver; it is a
///   constant, reported on the wire, not a per-row value.
///
/// Only `loadOffers` and `routeAlerts` have a sender today. The other three are
/// stored preferences waiting for one.
model DriverNotificationSettings {
  driverProfileId String        @id
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  loadOffers        Boolean @default(true)
  routeAlerts       Boolean @default(true)
  jobReminders      Boolean @default(true)
  payouts           Boolean @default(true)
  tipsAndPromotions Boolean @default(false)

  /// Quiet hours: while on, non-urgent categories are not pushed between the
  /// two minutes-of-day below (Tbilisi wall clock; the window may wrap past
  /// midnight, and does by default: 23:00 → 07:00).
  quietHoursEnabled     Boolean @default(false)
  quietHoursStartMinute Int     @default(1380)
  quietHoursEndMinute   Int     @default(420)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Days of the week, for a route alert's days and a driver's working days.
enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

/// A saved route a driver wants to be told about: "loads from `fromCity` to
/// `toCity` paying at least `minPayout`, picked up on one of `days`".
///
/// `toCity` null is the design's "anywhere". `minPayout` is compared with the
/// **driver's** payout (`Order.driverPayout`), never the client's price.
/// `days` is the pick-up's weekday in Tbilisi time and is never empty.
///
/// At most `MAX_ROUTE_ALERTS_PER_DRIVER` per driver
/// (`src/lib/route-alerts/rules.ts`), enforced by the create route.
model RouteAlert {
  id String @id @default(cuid())

  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  fromCity  GeorgianCity
  toCity    GeorgianCity?
  minPayout Float         @default(0)
  days      Weekday[]
  enabled   Boolean       @default(true)

  fires RouteAlertFire[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverProfileId])
  // The matcher's read: enabled alerts whose pick-up city is the new load's.
  @@index([enabled, fromCity])
}

/// "This driver was alerted about this load." Written when a route alert is
/// pushed, and what makes one push per driver per load true by construction:
/// `@@unique([orderId, driverProfileId])` refuses the second row, whichever of
/// the driver's alerts matched and however many times the trigger runs.
///
/// `alertId` names the alert that matched and is `SetNull`, so deleting an
/// alert does not re-arm the loads it already fired for.
model RouteAlertFire {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  alertId String?
  alert   RouteAlert? @relation(fields: [alertId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([orderId, driverProfileId])
  @@index([driverProfileId])
  @@index([alertId])
}

/// What work a driver wants to be **offered**: the Account → Work preferences
/// screen. Read by the offer matcher only (`src/lib/offers/`); the public load
/// board is never filtered by it.
///
/// **No row means no preferences**, and the matcher then behaves exactly as it
/// did before this model existed. The rules themselves are
/// `src/lib/work-preferences/rules.ts`.
///
/// - `cities` + `intercity` are the design's "Areas I work in" chips.
/// - `maxTripKm` is "Longest trip I'll take" — the job's own route length
///   (`Order.distanceKm`); null is the design's "Any".
/// - `days` / `startMinute` / `endMinute` are when offers may be sent, on the
///   Tbilisi wall clock. Equal start and end mean all day.
/// - `excludedHandlingTags` is the inverse of "Cargo I'll carry": the
///   `CargoHandlingTag`s the driver does not want. The design's "General" row
///   has no counterpart on an order and is not stored.
/// - `canBringHelper` false withholds loads that ask for helpers
///   (`Order.helperCount > 0`).
model DriverWorkPreferences {
  driverProfileId String        @id
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  cities    GeorgianCity[]
  intercity Boolean        @default(false)
  maxTripKm Int?

  days        Weekday[]
  startMinute Int       @default(0)
  endMinute   Int       @default(0)

  excludedHandlingTags CargoHandlingTag[] @default([])
  canBringHelper       Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Admin back office: RBAC and audit
// ---------------------------------------------------------------------------

/// Fixed set of internal-staff roles for the admin back office. Deliberately a
/// closed enum rather than a dynamic permissions table — see
/// specs/admin-back-office/requirements.md's Non-Goals for why. `SUPER_ADMIN`
/// can do everything, including managing other System Users; the rest are
/// scoped to the section their name implies.
enum AdminRole {
  SUPER_ADMIN
  ANALYTICS
  CONTENT_MANAGER
  FINANCE_MANAGER
  USER_MANAGER
  CRM_MANAGER
  SUPPORT
}

/// One row per internal-staff `User` (role `ADMIN`). Kept separate from `User`
/// itself for the same reason `ClientProfile`/`DriverProfile` are separate:
/// role-specific data stays off the base auth table. `isActive` is the kill
/// switch a `SUPER_ADMIN` flips to revoke back-office access without deleting
/// the underlying `User`/auth rows.
model SystemUserProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminRole AdminRole
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Append-only record of admin actions, written by every create/update/delete
/// mutation in `/admin`. `action` is a free-form dotted string agreed by
/// convention across tasks, e.g. `"banner.create"`, `"promo_campaign.disable"`,
/// `"system_user.deactivate"` — there is no enum because the set of actions
/// grows with every admin feature and a migration per new action would be
/// impractical. `metadata` carries whatever the specific action needs (old/new
/// values, affected ids) as a debugging/compliance trail, not as query-critical
/// data.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Admin back office: content management
// ---------------------------------------------------------------------------

/// Locales the admin back office manages content in. Deliberately just these
/// two (see requirements.md's Assumptions) — add a value here and re-migrate
/// if a third locale is ever needed.
enum ContentLocale {
  KA
  EN
}

/// A promotional image slot the admin places on the public site. `placement`
/// is a free-form key (not an enum) that the admin UI and the landing-page
/// components agree on by convention, e.g. `"home_hero"`, `"home_secondary"` —
/// this keeps adding a new placement a content change, not a schema change.
model Banner {
  id        String        @id @default(cuid())
  title     String
  locale    ContentLocale
  imageUrl  String
  linkUrl   String?
  placement String
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([locale, placement, isActive])
}

/// Admin-authored standalone pages (Terms, Privacy, About, etc.). `slug` is
/// the URL segment; unique per locale so the same slug can exist in both `ka`
/// and `en` as separate rows.
model StaticPage {
  id          String        @id @default(cuid())
  slug        String
  locale      ContentLocale
  title       String
  bodyHtml    String
  isPublished Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([slug, locale])
}

/// A single translated string. `namespace` groups keys the way i18n libraries
/// conventionally do (e.g. `"common"`, `"booking"`, `"admin"`) so the admin UI
/// can list translations grouped by area of the app instead of one flat list.
model TranslationEntry {
  id        String        @id @default(cuid())
  namespace String
  key       String
  locale    ContentLocale
  value     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([namespace, key, locale])
}

/// Channel a `MessagingTemplate` is written for. Push is explicitly out of
/// scope for this pass (see requirements.md).
enum MessagingChannel {
  EMAIL
  SMS
}

/// Editable content for a transactional message (e.g. order confirmed, driver
/// assigned, delivered, cancelled). `key` is the event/trigger identifier the
/// order-lifecycle code looks up by convention (documented per-key in
/// task-14, which wires actual sending) — e.g. `"order.confirmed"`,
/// `"driver.assigned"`. `subject` is meaningful for `EMAIL` only and is left
/// null for `SMS` rows. This task only creates the table; a later task builds
/// the CRUD UI for template *content*, and another later task is what
/// actually sends anything using this content.
model MessagingTemplate {
  id        String           @id @default(cuid())
  key       String
  channel   MessagingChannel
  locale    ContentLocale
  subject   String?
  body      String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  crmCampaigns CrmCampaign[]

  @@unique([key, channel, locale])
}

/// One composable block of the public landing/home page (hero, vehicle types,
/// how-it-works, FAQ, CTA, etc.), ordered by `sortOrder`. `type` identifies
/// which landing component renders it (free-form key by convention, matching
/// the existing component names under `src/components/landing/`, e.g.
/// `"hero"`, `"vehicle_types"`, `"how_it_works"`, `"faq"`); `content` is
/// arbitrary structured data specific to that type (headline/subtext for
/// `"hero"`, a list of items for `"faq"`, etc.) since a fixed column shape
/// can't fit every section type.
model HomePageSection {
  id        String        @id @default(cuid())
  type      String
  locale    ContentLocale
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  content   Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([locale, isActive, sortOrder])
}

// ---------------------------------------------------------------------------
// Admin back office: finances
// ---------------------------------------------------------------------------

/// Payment methods the platform can offer at checkout. `CASH` (cash on
/// delivery) needs no gateway and is the safe default while gateway
/// integration is still pending a provider decision — see action-required.md.
enum PaymentMethodType {
  CASH
  CARD
  BANK_TRANSFER
}

/// Admin-controlled on/off switch (plus non-secret config) per payment
/// method. There is exactly one row per `PaymentMethodType` value; API keys
/// and other secrets never live in `config` — those stay in environment
/// variables, same as every other credential in this project.
model PaymentMethodConfig {
  id        String            @id @default(cuid())
  type      PaymentMethodType @unique
  isEnabled Boolean           @default(false)
  config    Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

/// A card a client has added to their payment methods, for display and for
/// pre-selection at checkout.
///
/// NO PAN AND NO CVC IS EVER STORED, TRANSMITTED OR LOGGED. The card number and
/// security code are entered in the browser, used there to derive `brand` and
/// `last4`, and discarded; neither ever reaches this server, so neither can reach
/// this table. `providerToken` is the column a real gateway's token would occupy
/// once a provider is chosen (see action-required.md) — it is null for every row
/// this app can currently create, and it is a token, never a card number.
///
/// Nothing here can charge anybody. Until a gateway exists, a row is a label on a
/// payment intention, and an order chosen against one is still settled off-platform.
model SavedCard {
  id       String @id @default(cuid())
  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// The gateway's own opaque handle for this card. Null until a provider is
  /// chosen. Never a PAN. Unique so the same card cannot be tokenised twice.
  providerToken String? @unique
  /// The gateway that issued `providerToken`, left a plain string for the same
  /// reason as `Payment.provider`: no provider is chosen yet.
  provider      String?

  /// Display only, both derived in the browser from a number that is never sent
  /// here: the scheme name (e.g. "Visa") and the last four digits.
  brand      String
  last4      String
  expMonth   Int
  expYear    Int
  holderName String?
  /// At most one default per client, enforced by the database: a partial unique
  /// index on `("clientId") WHERE "isDefault"`. Prisma's schema language cannot
  /// express a partial index — `@@unique` has no WHERE clause — so it is
  /// declared only in SQL, by the migration
  /// `20260903060000_saved_card_default_unique`.
  ///
  /// The write path still demotes the previous default before promoting the new
  /// one, in a single transaction; the index is what makes that ordering hold
  /// under concurrency, where two transactions would otherwise each demote a
  /// snapshot taken before the other's uncommitted write.
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([clientId])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// One row per `Order` once a payment attempt exists. `provider` and
/// `providerPaymentId` are left generic (plain strings, not an enum/FK to a
/// specific gateway's SDK types) because the concrete provider is not yet
/// chosen (see action-required.md) — a later task is what actually
/// populates and transitions these rows.
model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  providerPaymentId String?
  amount            Float
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  /// **Funds confirmed received by a payment gateway** — the only fact that
  /// lets a job credit a driver's wallet. Deliberately distinct from `status`
  /// and `provider`: with no gateway integrated, `POST /api/orders/[id]/pay`
  /// writes `PAID` for a card without charging anything and `provider: "none"`,
  /// so neither proves money arrived. Null on every row until a real gateway
  /// exists. Written by exactly one function, `confirmGatewayPayment`
  /// (`src/lib/orders/payment-settlement.ts`), and never by a route.
  gatewayConfirmedAt DateTime?
  /// Which gateway confirmed, e.g. `"tbc-pay"`. Never `"none"`.
  gatewayName        String?
  /// That gateway's own id for the captured payment. Unique per gateway, so
  /// one captured payment can never confirm two orders.
  gatewayReference   String?

  @@unique([gatewayName, gatewayReference])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Driver wallet
 */
/**
 * --------------------------------------------------------------------------
 */

/// The five banks the driver app offers. The two-letter code inside a Georgian
/// IBAN for each is in `src/lib/wallet/rules.ts` (`GEORGIAN_BANKS`).
enum GeorgianBank {
  TBC
  BANK_OF_GEORGIA
  LIBERTY
  PROCREDIT
  BASISBANK
}

/// `PENDING` until an admin compares the account with the driver's reviewed
/// identity; only a `VERIFIED` account can receive a withdrawal.
enum BankAccountStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// A bank account an **independent** driver wants withdrawals paid to. The
/// holder is always the driver's legal name — it is read from the profile, not
/// stored here and not editable. Removal is soft (`removedAt`) because paid
/// withdrawals keep pointing at the account they went to.
model DriverBankAccount {
  id              String        @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)
  bank            GeorgianBank
  /// 22 characters, upper case, no spaces; validated (format, mod-97, bank
  /// code) by `validateGeorgianIban` before it is stored.
  iban            String

  status          BankAccountStatus @default(PENDING)
  /// Shown to the driver verbatim when `status` is `REJECTED`.
  rejectionReason String?
  /// At most one per driver, and only ever a `VERIFIED` account.
  isDefault       Boolean           @default(false)
  reviewedAt      DateTime?
  /// `User.id` of the staff member; a plain column so removing a staff account
  /// never touches a money record. The audit log names the actor too.
  reviewedById    String?
  removedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  withdrawals Withdrawal[]

  @@index([driverProfileId])
  @@index([status, createdAt])
  @@index([iban])
}

/// `PENDING` reserves the amount. `PAID` (an admin made the bank transfer and
/// recorded its reference) posts the debit to the ledger. `REJECTED` releases
/// the reservation and posts nothing. `REVERSED` is a `PAID` withdrawal whose
/// transfer came back; it posts a `WITHDRAWAL_REVERSAL` credit.
enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
  REVERSED
}

/// A driver's request to be paid out, fulfilled by hand: staff transfer the
/// money outside the system and record the result here.
model Withdrawal {
  id              String            @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile     @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)
  bankAccountId   String
  bankAccount     DriverBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  /// Integer tetri, always positive.
  amountTetri     Int
  status          WithdrawalStatus  @default(PENDING)

  /// The destination as it was when requested, so the record of where money
  /// went survives a later change to the account or the driver's name.
  bank              GeorgianBank
  iban              String
  accountHolderName String

  /// The bank's reference for the transfer; set with `PAID`.
  bankReference   String?
  /// Shown to the driver verbatim; set with `REJECTED`.
  rejectionReason String?
  /// Why a paid withdrawal was reversed; set with `REVERSED`.
  reversalReason  String?
  decidedAt       DateTime?
  /// `User.id` of the staff member who paid or rejected it.
  decidedById     String?

  /// Client-chosen key: repeating a request with the same key returns the
  /// first withdrawal instead of reserving twice. **Required by the API**
  /// (`POST /api/dashboard/hub/wallet/withdrawals` refuses a request without
  /// one), so every row written from now on has it; the column stays nullable
  /// only because rows requested before that rule may not.
  requestKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries WalletLedgerEntry[]

  @@unique([driverProfileId, requestKey])
  @@index([driverProfileId, createdAt])
  @@index([status, createdAt])
  @@index([bankAccountId])
}

enum WalletEntryType {
  /// `Order.driverPayout` of a completed, gateway-confirmed job. Credit.
  JOB_PAYOUT
  /// `Order.overtimeDriverPayout` of the same job, when non-zero. Credit.
  JOB_OVERTIME
  /// A withdrawal marked `PAID`. Debit.
  WITHDRAWAL
  /// A paid withdrawal whose transfer was returned. Credit.
  WITHDRAWAL_REVERSAL
  /// A manual correction by staff, with a reason. Either sign.
  ADJUSTMENT
}

/// The wallet's ledger. **Append-only**: no code path updates or deletes a
/// row. A driver's balance is the sum of their rows' `amountTetri`; what they
/// may withdraw is that minus their `PENDING` withdrawals.
///
/// The two unique constraints are what make posting idempotent: one job can
/// hold at most one `JOB_PAYOUT` and one `JOB_OVERTIME`, one withdrawal at most
/// one `WITHDRAWAL` and one `WITHDRAWAL_REVERSAL` — a repeated trigger collides
/// instead of double-posting. (Rows with a null `orderId`/`withdrawalId` never
/// collide: Postgres treats nulls as distinct.)
model WalletLedgerEntry {
  id              String          @id @default(cuid())
  driverProfileId String
  driverProfile   DriverProfile   @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)
  type            WalletEntryType
  /// Signed integer tetri: positive credits the driver, negative debits.
  amountTetri     Int

  orderId      String?
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  withdrawalId String?
  withdrawal   Withdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)
  /// `ADJUSTMENT` only: why. Shown to the driver verbatim.
  reason       String?
  /// `User.id` of the staff member, for entries a person caused.
  createdById  String?

  createdAt DateTime @default(now())

  @@unique([orderId, type])
  @@unique([withdrawalId, type])
  @@index([driverProfileId, createdAt])
}

/// Why a completed, gateway-confirmed job was **not** credited although its
/// driver exists — today only one reason.
enum WalletCreditHoldReason {
  /// A roster driver claimed an open load themselves: the order records only
  /// `driverId`, so it is owed neither to their company (no `companyId`) nor to
  /// a wallet (roster drivers have none). Who is paid is an open owner
  /// decision; until then the job produces no ledger entry and this row.
  ROSTER_SELF_CLAIM
}

/// One row per job the crediting function deliberately skipped, so the case is
/// visible to finance staff instead of silently absent. Once a hold exists the
/// order is never credited automatically, even if the driver later leaves the
/// company — resolving it is a manual adjustment.
model WalletCreditHold {
  id              String                 @id @default(cuid())
  orderId         String                 @unique
  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverProfileId String
  driverProfile   DriverProfile          @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  /// The company the job was claimed under (`Order.driverClaimCompanyId`), when
  /// the claim recorded one; otherwise the driver's employer when the hold was
  /// written.
  companyId       String?
  reason          WalletCreditHoldReason
  /// What would have been credited (payout + overtime), integer tetri.
  amountTetri     Int
  createdAt       DateTime               @default(now())

  @@index([driverProfileId])
  @@index([createdAt])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// A discount code an admin creates and clients redeem at checkout.
/// `usedCount` is incremented by the checkout/order-creation path whenever a
/// code is applied — this task only creates the table, wiring redemption into
/// order creation is out of scope for the admin spec itself.
model PromoCampaign {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  startsAt      DateTime
  endsAt        DateTime
  usageLimit    Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Admin back office: CRM (scoped down — see requirements.md Non-Goals)
// ---------------------------------------------------------------------------

/// A saved audience filter. `criteria` is a small, admin-authored JSON filter
/// (e.g. `{"role": "CLIENT", "minOrders": 5}`) interpreted by a later task's
/// segment-preview logic — not a rules engine or query builder.
model CrmSegment {
  id          String   @id @default(cuid())
  name        String
  description String?
  criteria    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns CrmCampaign[]
}

enum CrmCampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

/// A marketing send: a `CrmSegment` (the audience) paired with a
/// `MessagingTemplate` (the content) and a schedule. Actually dispatching a
/// campaign depends on a later task's send integration; this task only
/// creates the table.
model CrmCampaign {
  id          String             @id @default(cuid())
  name        String
  segmentId   String?
  segment     CrmSegment?        @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  templateId  String?
  template    MessagingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  status      CrmCampaignStatus  @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([segmentId])
  @@index([templateId])
}

/// An admin-authored survey. `questions` is a JSON array of
/// `{id, prompt, type, options?}` objects — free-form enough to cover simple
/// question types (text, single-choice, multi-choice) without a table per
/// question type.
model CrmSurvey {
  id        String   @id @default(cuid())
  title     String
  questions Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses CrmSurveyResponse[]
}

/// One respondent's answers to a `CrmSurvey`. `userId` is nullable so an
/// anonymous/unauthenticated respondent can still submit (out of scope for
/// this spec to expose publicly, but the schema shouldn't force a user).
model CrmSurveyResponse {
  id        String    @id @default(cuid())
  surveyId  String
  survey    CrmSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers   Json
  createdAt DateTime  @default(now())

  @@index([surveyId])
}
